# Postgres connection string (Neon / Vercel Postgres / Supabase). Neon: use the "pooled" URL.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Google Cloud > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Only Google accounts of this domain can sign in
ALLOWED_DOMAIN=rankviz.com

# Random secret for the login cookie:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# The very first HR account. Used ONLY while the employees table is empty.
BOOTSTRAP_HR_EMAIL=hr@rankviz.com
BOOTSTRAP_HR_NAME=HR Manager
